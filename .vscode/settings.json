{
    "ruff.path": ["${workspaceFolder}/.venv/Scripts/ruff.exe"],
    "python.testing.pytestArgs": [
        "-s"
    ],
    "files.watcherExclude": {
        "**/DBDofusUnity/datas/**": true,
        "**/DBDofusUnity/Il2CppInspectorRedux/**": true,
        "**/DBDofusUnity/protodec/**": true,
        "**/DBDofusUnity/UABEA/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.jj": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "build": true,
        "dist": true,
    },
    "search.exclude": {
        "**/DBDofusUnity/datas": true,
        "**/DBDofusUnity/Il2CppInspectorRedux": true,
        "**/DBDofusUnity/protodec": true,
        "**/DBDofusUnity/UABEA": true,
        "**/.venv": true,
        "**/__pycache__": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "pyproject.toml": "uv.lock,BillBot.spec, pyrightconfig.json",
        ".env": ".env.*"
    },
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10
}
